<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<BaseOutputPath>..\bin\</BaseOutputPath>
		<Authors>Vorcyc cyclone@</Authors>
		<Product>Vorcyc.Metis</Product>
		<PackageId>Vorcyc.Metis</PackageId>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<Description>Vorcyc Metis is a powerful web crawling and data extraction framework designed for efficiency and scalability.</Description>
		<AssemblyName>Vorcyc.Metis</AssemblyName>
		<PackageIcon>metis_logo.png</PackageIcon>
		<ApplicationIcon>Resources\metis_icon.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
		<PackageReference Include="System.Speech" Version="10.0.0" />
		<PackageReference Include="Vorcyc.PowerLibrary.WindowsDesktop" Version="9.0.6" />
		<PackageReference Include="Vorcyc.RoundUI" Version="1.0.0" />
		<PackageReference Include="WindowsAPICodePack" Version="8.0.12" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Vorcyc.Metis.Classifiers\Vorcyc.Metis.Classifiers.csproj" />
	  <ProjectReference Include="..\Vorcyc.Metis.CrawlerPrimitives\Vorcyc.Metis.CrawlerPrimitives.csproj" />
	  <ProjectReference Include="..\Vorcyc.Metis.Storage\Vorcyc.Metis.Storage.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Images\exit.png" />
		<Resource Include="Images\exit_hover.png" />
		<Resource Include="Images\min.png" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Properties\Resources.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Resources.resx</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Properties\Resources.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>Resources.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
	  <None Update="chrome_archives.zip">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="Images\metis_logo.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>
	
</Project>
