<Window x:Class="Vorcyc.Metis.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Vorcyc.Metis"
        mc:Ignorable="d"
        Title="Vorcyc Metis" SizeToContent="WidthAndHeight" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        WindowState="Normal"  ResizeMode="CanMinimize"  
        WindowStyle="None" AllowsTransparency="True" Opacity="0.9">

    <Window.Resources>
        <!-- Shared brushes to match window chrome -->
        <LinearGradientBrush x:Key="ChromeBorderBrush" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Offset="0" Color="#FFBABAB8" />
            <GradientStop Offset="1" Color="#FF777671" />
        </LinearGradientBrush>

        <!-- Base background similar to window -->
        <LinearGradientBrush x:Key="ChromeBg_Normal" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Offset="0"   Color="#F041413C" />
            <GradientStop Offset="0.5" Color="#FA2B2721" />
            <GradientStop Offset="0.5" Color="#FF24211A" />
            <GradientStop Offset="1"   Color="#FF232219" />
        </LinearGradientBrush>

        <!-- Hover and Pressed variants -->
        <LinearGradientBrush x:Key="ChromeBg_Hover" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Offset="0"   Color="#F05B5A54" />
            <GradientStop Offset="0.5" Color="#FA3A352E" />
            <GradientStop Offset="0.5" Color="#FF2D2922" />
            <GradientStop Offset="1"   Color="#FF2A291F" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ChromeBg_Pressed" StartPoint="0.5,1" EndPoint="0.5,0">
            <GradientStop Offset="0"   Color="#FF1A1913" />
            <GradientStop Offset="1"   Color="#FF221F18" />
        </LinearGradientBrush>

        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFECEBE6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Background" Value="{StaticResource ChromeBg_Normal}"/>
            <!--<Setter Property="BorderBrush" Value="{StaticResource ChromeBorderBrush}"/>-->
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Chrome"
                                    CornerRadius="4"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <!-- subtle inner highlight -->
                                <Border CornerRadius="3" BorderThickness="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1" Opacity="0.15">
                                            <GradientStop Offset="0" Color="#FFFFFFFF"/>
                                            <GradientStop Offset="0.5" Color="#00FFFFFF"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Border>

                            <ContentPresenter x:Name="contentPresenter"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ChromeBg_Hover}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Offset="0" Color="#FFF0F0EE"/>
                                            <GradientStop Offset="1" Color="#FF9B9A94"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ChromeBg_Pressed}"/>
                                <Setter TargetName="contentPresenter" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="Gray"/>
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="1"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" TargetName="Chrome" Value="0.5"/>
                                <Setter Property="Foreground" Value="#FF9A9994"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--像工具栏按钮的 ToggleButton-->
        <Style x:Key="SunkenToggleButton" TargetType="Button">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <!-- Use Foreground as the brush for Path.Fill -->
            <Setter Property="Foreground" Value="WhiteSmoke"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Padding="5"
                                Margin="0"
                                BorderThickness="1"
                                CornerRadius="4">
                            <!-- ContentPresenter passes Foreground down; Path must bind to it -->
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF3D3D3D"/>
                                <!-- Change Path fill via Foreground -->
                                <Setter Property="Foreground" Value="#FFFFD65C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="#FFFFA000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FF7A7A7A"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- 播放/停止切换的 ToggleButton 样式 -->
        <Style x:Key="PlayStopToggleButton" TargetType="ToggleButton">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Foreground" Value="WhiteSmoke"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Padding="5"
                                Margin="0"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Path x:Name="IconPath"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Stretch="Fill"
                                  Width="8"
                                  Height="12"
                                  Fill="{TemplateBinding Foreground}"
                                  Data="M73 39c-14.8-9.1-33.4-9.4-48.5-.9S0 62.6 0 80L0 432c0 17.4 9.4 33.4 24.5 41.9s33.7 8.1 48.5-.9L361 297c14.3-8.7 23-24.2 23-41s-8.7-32.2-23-41L73 39z"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover/Pressed/Disabled 配色 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF3D3D3D"/>
                                <Setter Property="Foreground" Value="#FFFFD65C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="#FFFFA000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FF7A7A7A"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>

                            <!-- 勾选=停止图标 -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="IconPath" Property="Data"
                                Value="M0 128C0 92.7 28.7 64 64 64H320c35.3 0 64 28.7 64 64V384c0 35.3-28.7 64-64 64H64c-35.3 0-64-28.7-64-64V128z"/>
                                <Setter TargetName="IconPath" Property="Width" Value="12"/> 
                                <Setter Property="Foreground" Value="OrangeRed"/>
                            </Trigger>

                            <!-- 未勾选=播放图标 -->
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="IconPath" Property="Data"
                                Value="M73 39c-14.8-9.1-33.4-9.4-48.5-.9S0 62.6 0 80L0 432c0 17.4 9.4 33.4 24.5 41.9s33.7 8.1 48.5-.9L361 297c14.3-8.7 23-24.2 23-41s-8.7-32.2-23-41L73 39z"/>
                                <Setter Property="Foreground" Value="GreenYellow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid x:Name="LayoutRoot">
        <!--淡化边-->
        <Rectangle StrokeThickness="5" RadiusX="5" RadiusY="5" Margin="5">
            <!--<Rectangle.Effect>
                <BlurEffect KernelType="Box" />
            </Rectangle.Effect>-->
            <Rectangle.Stroke>
                <RadialGradientBrush>
                    <GradientStop Color="Black" Offset="0.8"/>
                    <GradientStop Offset="1" Color="Black" />
                </RadialGradientBrush>
            </Rectangle.Stroke>
        </Rectangle>

        <Border CornerRadius="5" BorderThickness="2" Margin="5">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Offset="0" Color="#FFBABAB8" />
                    <GradientStop Offset="1" Color="#FF777671" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Offset="0" Color="#D841413C" />
                    <GradientStop Offset="0.5" Color="#D82B2721" />
                    <GradientStop Offset="0.5" Color="#E524211A" />
                    <GradientStop Offset="1" Color="#E5232219" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.5*"/>
                    <RowDefinition Height="0.5*"/>
                </Grid.RowDefinitions>


                <Grid Grid.Column="0" Grid.RowSpan="2" Margin="0">
                    <!-- Main content goes here -->

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.5*"/>
                        <RowDefinition Height="0.5*"/>
                    </Grid.RowDefinitions>

                    <Button Style="{StaticResource SunkenToggleButton}" Grid.Column="0" Grid.Row="0" Margin="1"
                            VerticalAlignment="Bottom" VerticalContentAlignment="Bottom"
                            x:Name="btnPrevious" Click="btnPrevious_Click" IsEnabled="False">
                        <Path HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Stretch="Fill"
                          Width="8"
                          Height="12"
                          Data="M169.4 41.4c12.5-12.5 32.8-12.5 45.3 0l160 160c9.2 9.2 11.9 22.9 6.9 34.9s-16.6 19.8-29.6 19.8l-96 0 0 184c0 22.1-17.9 40-40 40l-48 0c-22.1 0-40-17.9-40-40l0-184-96 0c-12.9 0-24.6-7.8-29.6-19.8s-2.2-25.7 6.9-34.9l160-160z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>

                    <Button Style="{StaticResource SunkenToggleButton}" Grid.Column="0" Grid.Row="1" Margin="1"
                            x:Name="btnNext" Click="btnNext_Click" IsEnabled="False">
                        <Path HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Stretch="Fill"
                          Width="8"
                          Height="12"
                          Data="M214.6 470.6c-12.5 12.5-32.8 12.5-45.3 0l-160-160c-9.2-9.2-11.9-22.9-6.9-34.9s16.6-19.8 29.6-19.8l96 0 0-184c0-22.1 17.9-40 40-40l48 0c22.1 0 40 17.9 40 40l0 184 96 0c12.9 0 24.6 7.8 29.6 19.8s2.2 25.7-6.9 34.9l-160 160z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>

                    <Border Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="2" Grid.RowSpan="2" 
                            Height="54" Width="400" 
                            BorderBrush="#252525" BorderThickness="2" CornerRadius="3">
                        <Grid Margin="8" DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 第一行：左侧标题，右侧 meta（发布者 | 时间 | 类别） -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 标题靠左 -->
                                <TextBlock Grid.Column="0"
                                      Foreground="#FFECEBE6"
                                      FontSize="11"
                                      TextTrimming="CharacterEllipsis"
                                      Text="{Binding CurrentArchive.Title}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top"
                                      TextWrapping="NoWrap"/>

                                <!-- Meta 靠右 -->
                                <TextBlock Grid.Column="1"
                                      Foreground="#FFBFBEB9"
                                      FontSize="10"
                                      TextTrimming="CharacterEllipsis"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"
                                      TextAlignment="Right"
                                      Text="{Binding ArchiveMetaLine}">
                                </TextBlock>
                            </Grid>

                            <!-- 第二行：内容自动滚动显示 -->
                            <ScrollViewer x:Name="ContentScrollViewer"
                                  Grid.Row="1" Margin="0,6,0,0"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  MouseEnter="ContentScrollViewer_MouseEnter"
                                  MouseLeave="ContentScrollViewer_MouseLeave">
                                <TextBlock x:Name="ContentTextBlock"
                                   Text="{Binding CurrentArchive.Content}"
                                   Foreground="#FFECEBE6"
                                   TextWrapping="Wrap"
                                   FontSize="12"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>


                </Grid>


                <Grid Grid.Column="1" Grid.Row="0" Grid.RowSpan="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0">
                        <Image x:Name="btnMinimize"
                               Source="/Images/min.png"
                               Stretch="None"
                               Margin="2,0,2,0"
                               MouseLeftButtonDown="btnMinimize_MouseLeftButtonDown"/>
                        <Image Source="/Images/exit.png" Stretch="None" Margin="2,0,5,0" 
                               MouseEnter="Image_MouseEnter"
                               MouseLeave="Image_MouseLeave"
                               MouseLeftButtonDown="Image_MouseLeftButtonDown"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.RowSpan="2">
                        <ToggleButton x:Name="btnPlayStop"
                          Style="{StaticResource PlayStopToggleButton}"
                          ToolTip="播放/停止"
                          Width="36"
                          Margin="0 8 0 5"
                          Checked="btnPlayStop_Checked"
                          Unchecked="btnPlayStop_Unchecked"/>
                    </StackPanel>

                </Grid>

            </Grid>

        </Border>

    </Grid>
</Window>
